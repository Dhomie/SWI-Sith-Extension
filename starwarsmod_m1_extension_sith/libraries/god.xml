            <select faction="sith" tags="[defence]" />
            <loadout>
              <level exact="1.0" />
            </loadout>
          </station>
        </station>
		
	</add>
	
	<!-- Self-sustaining, because they don't have any faction to trade with -->
	<add sel="//god/products">
